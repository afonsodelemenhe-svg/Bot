DISCORD_TOKEN=cole_seu_token_aqui
CLIENT_ID=seu_application_id
# Opcional: use o ID do servidor para registrar o comando durante testes
GUILD_ID=
# Moderação automática: false desativa regras de convite/spam/menções
AUTOMOD_ENABLED=true
MAX_MENTIONS=5
SPAM_LIMIT=5
SPAM_WINDOW_MS=8000
TIMEOUT_SECONDS=60
# Moderação com IA: defina uma chave da API para habilitar a classificação de mensagens
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
AI_MODERATION_ENABLED=true
# 0 = não aplica timeout para mensagens sinalizadas pela IA
AI_MODERATION_TIMEOUT_SECONDS=0
